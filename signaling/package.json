{
  "name": "@cloudplay/signaling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write src test *.json *.js",
    "format:check": "prettier --check src test *.json *.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.3.1",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
